TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Reviactyl/single Python hosting: keep this empty or remove it.
TELEGRAM_BOT_API_URL=

# Automatically compress cloud Bot API uploads safely below 49 MB.
# The source frame rate is preserved; only resolution/bitrate are reduced.
AUTO_COMPRESS_FOR_CLOUD=true
CLOUD_UPLOAD_TARGET_MB=47
COMPRESSION_MAX_SHORT_SIDE=1080
COMPRESSION_PRESET=medium
COMPRESSION_TIMEOUT_SECONDS=1800
MAX_CONCURRENT_COMPRESSIONS=1

# Optional: only needed when you later deploy Telegram Local Bot API on a VPS.
# Get both values from:
# https://my.telegram.org/apps
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH

TELEGRAM_VERBOSITY=1
LOCAL_API_MAX_UPLOAD_MB=1990

MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=900

# FPS API (same process as the Telegram bot)
FPS_API_HOST=0.0.0.0
FPS_API_PORT=3008
FPS_API_MAX_JOBS=2
FPS_API_JOB_TTL_SECONDS=1800

# Recommended: set a long random secret, and use the same value in Vercel.
FPS_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional yt-dlp cookies file path.
TIKTOK_COOKIES=

# Optional: disk-backed temp directory for large 2K/4K video downloads.
# Reviactyl: leave blank to use .bot_tmp beside the bot files.
# Docker Compose overrides this with /data/bot-temp automatically.
BOT_TEMP_DIR=
